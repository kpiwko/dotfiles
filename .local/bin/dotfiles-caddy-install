#!/usr/bin/env python3
"""Install and configure the dotfiles-managed Caddy service."""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

PLACEHOLDER_TOKENS = {"", "changeme", "your_cloudflare_dns_edit_api_token", "your_api_token_here"}
PLACEHOLDER_EMAILS = {"", "you@example.com", "admin@example.com", "user@example.com", "changeme"}


def env(name: str, default: str) -> str:
    return os.environ.get(name, default)


@dataclass(frozen=True)
class Config:
    sudo: tuple[str, ...]
    role_bin: str
    src: Path
    etc: Path
    log: Path
    var: Path
    install_owner_flags: tuple[str, ...]
    caddy_version: str
    caddy_bin: Path
    libexec: Path
    launchd_dir: Path
    launchd_label: str
    launchctl: str
    xcaddy: str
    go: str
    mise: str

    @classmethod
    def from_env(cls) -> "Config":
        home = Path.home()
        return cls(
            sudo=tuple(shlex.split(env("SUDO", "sudo"))),
            role_bin=env("DOTFILES_ROLE_BIN", "dotfiles-role"),
            src=Path(env("DOTFILES_CADDY_SRC", str(home / ".config/caddy"))),
            etc=Path(env("CADDY_ETC_DIR", "/usr/local/etc/caddy")),
            log=Path(env("CADDY_LOG_DIR", "/var/log/caddy")),
            var=Path(env("CADDY_VAR_DIR", "/var/lib/caddy")),
            install_owner_flags=tuple(shlex.split(env("INSTALL_OWNER_FLAGS", "-o root -g wheel"))),
            caddy_version=env("CADDY_VERSION", "v2.9.1"),
            caddy_bin=Path(env("CADDY_BIN", "/usr/local/bin/caddy")),
            libexec=Path(env("CADDY_LIBEXEC_DIR", "/usr/local/libexec")),
            launchd_dir=Path(env("LAUNCHD_DIR", "/Library/LaunchDaemons")),
            launchd_label=env("LAUNCHD_LABEL", "local.caddy"),
            launchctl=env("LAUNCHCTL_BIN", "launchctl"),
            xcaddy=env("XCADDY_BIN", "xcaddy"),
            go=env("GO_BIN", "go"),
            mise=env("MISE_BIN", "mise"),
        )


def run(cmd: list[str], *, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=check, text=True, capture_output=capture)


def privileged(cfg: Config, *cmd: str, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return run([*cfg.sudo, *cmd], check=check, capture=capture)


def role_enabled(cfg: Config) -> bool:
    for role in ("ai-server", "cluster", "dev"):
        result = run([cfg.role_bin, "has", role], check=False)
        if result.returncode == 0:
            return True
    return False


def is_placeholder_token(value: str) -> bool:
    return value.strip() in PLACEHOLDER_TOKENS


def is_placeholder_email(value: str) -> bool:
    value = value.strip()
    return value in PLACEHOLDER_EMAILS or value.endswith("@example.com") or value.endswith("@example.internal")


def discover_acme_email() -> str:
    for name in ("DNS_ACME_EMAIL", "ACME_EMAIL"):
        value = os.environ.get(name, "")
        if not is_placeholder_email(value):
            return value
    result = run(["git", "config", "--get", "user.email"], check=False, capture=True)
    value = result.stdout.strip() if result.returncode == 0 else ""
    return value if not is_placeholder_email(value) else ""


def create_directories(cfg: Config) -> None:
    privileged(cfg, "mkdir", "-p", str(cfg.etc / "sites"), str(cfg.etc / "snippets"), str(cfg.etc / "env"), str(cfg.log), str(cfg.var))
    privileged(cfg, "chmod", "0750", str(cfg.etc), str(cfg.log), str(cfg.var))
    privileged(cfg, "chmod", "0700", str(cfg.etc / "env"))


def sync_dir(cfg: Config, source: Path, destination: Path) -> None:
    privileged(cfg, "rm", "-rf", str(destination))
    privileged(cfg, "mkdir", "-p", str(destination))
    for item in source.iterdir():
        if item.name.endswith(".example"):
            continue
        target = destination / item.name
        if item.is_dir():
            shutil.copytree(item, target)
        else:
            privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0644", str(item), str(target))


def sync_config(cfg: Config) -> None:
    sync_dir(cfg, cfg.src / "sites", cfg.etc / "sites")
    sync_dir(cfg, cfg.src / "snippets", cfg.etc / "snippets")
    privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0644", str(cfg.src / "Caddyfile"), str(cfg.etc / "Caddyfile"))


def read_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        for raw in path.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip().strip('"').strip("'")
    except (FileNotFoundError, PermissionError):
        pass
    return values


def write_cloudflare_env(cfg: Config, token: str, email: str) -> None:
    lines = [f"# Copied to {cfg.etc}/env/cloudflare.env by dotfiles-caddy-install", f"CF_API_TOKEN={token}"]
    if not is_placeholder_email(email):
        lines.append(f"ACME_EMAIL={email}")
    with tempfile.NamedTemporaryFile("w", delete=False) as handle:
        handle.write("\n".join(lines) + "\n")
        tmp = handle.name
    try:
        privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0600", tmp, str(cfg.etc / "env/cloudflare.env"))
    finally:
        Path(tmp).unlink(missing_ok=True)


def bootstrap_cloudflare_env(cfg: Config) -> bool:
    path = cfg.etc / "env/cloudflare.env"
    token = next((os.environ.get(name, "") for name in ("CF_API_TOKEN", "CLOUDFLARE_API_TOKEN", "AI_DEV_CF_API_TOKEN", "DEVCLUSTER_CF_API_TOKEN") if os.environ.get(name)), "")
    email = discover_acme_email()

    if not path.exists():
        if not is_placeholder_token(token):
            write_cloudflare_env(cfg, token, email)
            print(f"dotfiles-caddy-install: populated {path} from shell environment.", file=sys.stderr)
            return True
        privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0600", str(cfg.src / "env/cloudflare.env.example"), str(path))
        print(f"dotfiles-caddy-install: created {path} from the example template.", file=sys.stderr)
        print("Edit it now and set a real CF_API_TOKEN before starting Caddy.", file=sys.stderr)
        return False

    values = read_env_file(path)
    file_token = values.get("CF_API_TOKEN", "")
    file_email = values.get("ACME_EMAIL", "")
    if is_placeholder_token(file_token):
        if not is_placeholder_token(token):
            write_cloudflare_env(cfg, token, email)
            return True
        print(f"dotfiles-caddy-install: {path} contains a placeholder token.", file=sys.stderr)
        return False
    if is_placeholder_email(file_email):
        print(f"dotfiles-caddy-install: {path} is missing a real ACME_EMAIL.", file=sys.stderr)
        return False
    return True


def find_xcaddy(cfg: Config) -> str | None:
    candidates = [cfg.xcaddy, str(Path.home() / ".local/share/mise/shims/xcaddy"), str(Path.home() / "go/bin/xcaddy"), str(Path.home() / ".local/bin/xcaddy"), "/usr/local/bin/xcaddy"]
    for candidate in candidates:
        resolved = shutil.which(candidate) if "/" not in candidate else candidate
        if resolved and os.access(resolved, os.X_OK):
            return resolved
    return None


def ensure_xcaddy(cfg: Config) -> str:
    found = find_xcaddy(cfg)
    if found:
        return found
    if shutil.which(cfg.mise):
        run([cfg.mise, "use", "--global", "go:github.com/caddyserver/xcaddy/cmd/xcaddy@latest"], check=False)
        found = find_xcaddy(cfg)
        if found:
            return found
    if shutil.which(cfg.go):
        run([cfg.go, "install", "github.com/caddyserver/xcaddy/cmd/xcaddy@latest"], check=False)
        found = find_xcaddy(cfg)
        if found:
            return found
    raise RuntimeError("Neither mise nor go could provide xcaddy")


def build_caddy(cfg: Config) -> None:
    if cfg.caddy_bin.exists():
        result = run([str(cfg.caddy_bin), "version"], check=False, capture=True)
        if cfg.caddy_version in result.stdout:
            return
    xcaddy = ensure_xcaddy(cfg)
    with tempfile.TemporaryDirectory() as tmp:
        built = Path(tmp) / "caddy"
        run([xcaddy, "build", cfg.caddy_version, "--with", "github.com/caddy-dns/cloudflare", "--output", str(built)])
        privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0755", str(built), str(cfg.caddy_bin))


def validate_config(cfg: Config) -> None:
    values = read_env_file(cfg.etc / "env/cloudflare.env")
    child_env = os.environ.copy()
    child_env.update(values)
    child_env.setdefault("CF_API_TOKEN", "placeholder-for-validation")
    child_env.setdefault("ACME_EMAIL", "admin@example.internal")
    subprocess.run([str(cfg.caddy_bin), "validate", "--config", str(cfg.etc / "Caddyfile"), "--adapter", "caddyfile"], check=True, env=child_env)


def deploy_daemon(cfg: Config) -> None:
    privileged(cfg, "mkdir", "-p", str(cfg.libexec), str(cfg.launchd_dir))
    privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0755", str(cfg.src / "caddy-start"), str(cfg.libexec / "caddy-start"))
    plist = cfg.launchd_dir / f"{cfg.launchd_label}.plist"
    privileged(cfg, "install", *cfg.install_owner_flags, "-m", "0644", str(cfg.src / "local.caddy.plist"), str(plist))
    loaded = run([cfg.launchctl, "list", cfg.launchd_label], check=False).returncode == 0
    if loaded:
        privileged(cfg, cfg.launchctl, "kickstart", "-k", f"system/{cfg.launchd_label}")
    else:
        privileged(cfg, cfg.launchctl, "bootstrap", "system", str(plist))


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="dotfiles-caddy-install")
    parser.add_argument("--clean", action="store_true", help="wipe sites/snippets before syncing")
    parser.add_argument("--reinstall", action="store_true", help="alias for --clean")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    cfg = Config.from_env()
    if not role_enabled(cfg):
        print("dotfiles-caddy-install: none of ai-server, cluster, or dev roles is enabled.", file=sys.stderr)
        return 1
    create_directories(cfg)
    if args.clean or args.reinstall:
        privileged(cfg, "rm", "-rf", str(cfg.etc / "sites"), str(cfg.etc / "snippets"))
        create_directories(cfg)
    sync_config(cfg)
    if not bootstrap_cloudflare_env(cfg):
        return 0
    build_caddy(cfg)
    validate_config(cfg)
    deploy_daemon(cfg)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (subprocess.CalledProcessError, RuntimeError) as exc:
        print(f"dotfiles-caddy-install: {exc}", file=sys.stderr)
        raise SystemExit(1)
