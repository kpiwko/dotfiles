#!/bin/sh
set -eu

SUDO="${SUDO-sudo}"
DOTFILES_ROLE_BIN="${DOTFILES_ROLE_BIN:-dotfiles-role}"
DOTFILES_CADDY_SRC="${DOTFILES_CADDY_SRC:-$HOME/.config/caddy}"
CADDY_ETC_DIR="${CADDY_ETC_DIR:-/usr/local/etc/caddy}"
CADDY_LOG_DIR="${CADDY_LOG_DIR:-/var/log/caddy}"
CADDY_VAR_DIR="${CADDY_VAR_DIR:-/var/lib/caddy}"
INSTALL_OWNER_FLAGS="${INSTALL_OWNER_FLAGS--o root -g wheel}"
RSYNC_CHOWN_FLAG="${RSYNC_CHOWN_FLAG---chown=root:wheel}"
CADDY_VERSION="${CADDY_VERSION:-v2.9.1}"
CADDY_BIN="${CADDY_BIN:-/usr/local/bin/caddy}"
CADDY_LIBEXEC_DIR="${CADDY_LIBEXEC_DIR:-/usr/local/libexec}"
LAUNCHD_DIR="${LAUNCHD_DIR:-/Library/LaunchDaemons}"
LAUNCHD_LABEL="${LAUNCHD_LABEL:-local.caddy}"
LAUNCHCTL_BIN="${LAUNCHCTL_BIN:-launchctl}"
XCADDY_BIN="${XCADDY_BIN:-xcaddy}"
GO_BIN="${GO_BIN:-go}"
MISE_BIN="${MISE_BIN:-mise}"

CLEAN_MODE="${CLEAN_MODE:-0}"
REINSTALL_MODE="${REINSTALL_MODE:-0}"

run_privileged() {
  if [ -n "$SUDO" ]; then
    "$SUDO" "$@"
  else
    "$@"
  fi
}

require_role() {
  if ! "$DOTFILES_ROLE_BIN" has ai-server && ! "$DOTFILES_ROLE_BIN" has cluster && ! "$DOTFILES_ROLE_BIN" has dev; then
    echo "dotfiles-caddy-install: none of ai-server, cluster, or dev roles is enabled." >&2
    echo "Run: dotfiles-role enable <role>" >&2
    exit 1
  fi
}

create_directories() {
  run_privileged mkdir -p "$CADDY_ETC_DIR/sites" "$CADDY_ETC_DIR/snippets" "$CADDY_ETC_DIR/env" "$CADDY_LOG_DIR" "$CADDY_VAR_DIR"
  run_privileged chmod 0750 "$CADDY_ETC_DIR" "$CADDY_LOG_DIR" "$CADDY_VAR_DIR"
  run_privileged chmod 0700 "$CADDY_ETC_DIR/env"
}

sync_config() {
  run_privileged rsync -a --delete $RSYNC_CHOWN_FLAG --exclude='*.example' "$DOTFILES_CADDY_SRC/sites/" "$CADDY_ETC_DIR/sites/"
  run_privileged rsync -a --delete $RSYNC_CHOWN_FLAG --exclude='*.example' "$DOTFILES_CADDY_SRC/snippets/" "$CADDY_ETC_DIR/snippets/"
  run_privileged install $INSTALL_OWNER_FLAGS -m 0644 "$DOTFILES_CADDY_SRC/Caddyfile" "$CADDY_ETC_DIR/Caddyfile"
}

is_placeholder_token() {
  case "$1" in
    ""|"changeme"|"your_cloudflare_dns_edit_api_token"|"your_api_token_here")
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_placeholder_email() {
  case "$1" in
    "") return 0 ;;
    "you@example.com") return 0 ;;
    "admin@example.com") return 0 ;;
    "user@example.com") return 0 ;;
    "changeme") return 0 ;;
    *@example.com) return 0 ;;
    *@example.internal) return 0 ;;
    *) return 1 ;;
  esac
}

write_cloudflare_env() {
  token="$1"
  acme_email="${2:-}"
  tmp_env="$(mktemp)"
  if [ -n "$acme_email" ] && ! is_placeholder_email "$acme_email"; then
    cat > "$tmp_env" <<EOF
# Copied to $CADDY_ETC_DIR/env/cloudflare.env by dotfiles-caddy-install
CF_API_TOKEN=$token
ACME_EMAIL=$acme_email
EOF
  else
    cat > "$tmp_env" <<EOF
# Copied to $CADDY_ETC_DIR/env/cloudflare.env by dotfiles-caddy-install
CF_API_TOKEN=$token
EOF
  fi
  run_privileged install $INSTALL_OWNER_FLAGS -m 0600 "$tmp_env" "$CADDY_ETC_DIR/env/cloudflare.env"
  rm -f "$tmp_env"
}

discover_acme_email() {
  if [ -n "${DNS_ACME_EMAIL:-}" ] && ! is_placeholder_email "$DNS_ACME_EMAIL"; then
    printf '%s' "$DNS_ACME_EMAIL"
  elif [ -n "${ACME_EMAIL:-}" ] && ! is_placeholder_email "$ACME_EMAIL"; then
    printf '%s' "$ACME_EMAIL"
  else
    git config --get user.email 2>/dev/null | while read -r email; do
      if [ -n "$email" ] && ! is_placeholder_email "$email"; then
        printf '%s' "$email"
        break
      fi
    done || true
  fi
}

warn_on_placeholder_acme_email() {
  email="${1:-}"
  if [ -z "$email" ] || is_placeholder_email "$email"; then
    echo "dotfiles-caddy-install: WARNING: ACME_EMAIL is not configured. Set DNS_ACME_EMAIL or ACME_EMAIL in your shell environment." >&2
    echo "Using fallback from git config if available, but this will likely fail for Let's Encrypt verification." >&2
  fi
}

bootstrap_cloudflare_env() {
  env_file="$CADDY_ETC_DIR/env/cloudflare.env"
  env_token="${CF_API_TOKEN:-${CLOUDFLARE_API_TOKEN:-${AI_DEV_CF_API_TOKEN:-${DEVCLUSTER_CF_API_TOKEN:-}}}}"
  acme_email="$(discover_acme_email)"

  if ! run_privileged test -f "$env_file"; then
    if [ -n "$env_token" ] && ! is_placeholder_token "$env_token"; then
      write_cloudflare_env "$env_token" "$acme_email"
      echo "dotfiles-caddy-install: populated $env_file with API token and ACME_EMAIL from shell environment." >&2
    else
      # Create from example, then update if we have a valid email
      run_privileged install $INSTALL_OWNER_FLAGS -m 0600 "$DOTFILES_CADDY_SRC/env/cloudflare.env.example" "$env_file"
      echo "dotfiles-caddy-install: created $env_file from the example template." >&2
      
      # If we have a valid email, update it in the file
      if [ -n "$acme_email" ] && ! is_placeholder_email "$acme_email"; then
        tmp_env="$(mktemp)"
        cat "$env_file" | sed "s/^ACME_EMAIL=.*/ACME_EMAIL=$acme_email/" > "$tmp_env"
        run_privileged install $INSTALL_OWNER_FLAGS -m 0600 "$tmp_env" "$env_file"
        rm -f "$tmp_env"
        echo "dotfiles-caddy-install: updated ACME_EMAIL in $env_file from shell environment." >&2
      fi
      
      echo "Edit it now and set a real CF_API_TOKEN before starting Caddy." >&2
      exit 0
    fi
  else
    file_token="$(run_privileged /bin/sh -c "CF_API_TOKEN=''; . '$env_file' 2>/dev/null || true; printf '%s' \"\$CF_API_TOKEN\"" 2>/dev/null || true)"
    file_email="$(run_privileged /bin/sh -c "ACME_EMAIL=''; . '$env_file' 2>/dev/null || true; printf '%s' \"\$ACME_EMAIL\"" 2>/dev/null || true)"
    if is_placeholder_token "$file_token"; then
      if [ -n "$env_token" ] && ! is_placeholder_token "$env_token"; then
        write_cloudflare_env "$env_token" "$acme_email"
        echo "dotfiles-caddy-install: updated placeholder in $env_file with API token and ACME_EMAIL from shell environment." >&2
      else
        echo "dotfiles-caddy-install: $env_file contains placeholder token ($file_token)." >&2
        echo "Edit it now and set a real CF_API_TOKEN before starting Caddy." >&2
        exit 0
      fi
    elif is_placeholder_email "$file_email" || [ -z "$file_email" ]; then
      # Token is valid but email is missing or placeholder - do not update
      # The user should manually edit the file to add/update email
      if is_placeholder_email "$file_email"; then
        echo "dotfiles-caddy-install: $env_file contains placeholder email ($file_email)." >&2
        echo "Edit it now and set a real ACME_EMAIL before starting Caddy." >&2
        exit 0
      fi
    fi
    # File has a real token and email - do not modify it
  fi
}

find_xcaddy() {
  if [ -n "${XCADDY_BIN:-}" ] && [ -x "$XCADDY_BIN" ]; then
    return 0
  fi
  if [ -n "${XCADDY_BIN:-}" ] && command -v "$XCADDY_BIN" >/dev/null 2>&1; then
    XCADDY_BIN="$(command -v "$XCADDY_BIN")"
    return 0
  fi
  if command -v xcaddy >/dev/null 2>&1; then
    XCADDY_BIN="$(command -v xcaddy)"
    return 0
  fi

  if [ -x "$HOME/.local/share/mise/shims/xcaddy" ]; then
    XCADDY_BIN="$HOME/.local/share/mise/shims/xcaddy"
    return 0
  fi

  for candidate in "$HOME"/.local/share/mise/installs/go/*/bin/xcaddy; do
    if [ -x "$candidate" ]; then
      XCADDY_BIN="$candidate"
      return 0
    fi
  done

  if command -v "$GO_BIN" >/dev/null 2>&1; then
    _gobin="$("$GO_BIN" env GOBIN 2>/dev/null || true)"
    if [ -n "$_gobin" ] && [ -x "$_gobin/xcaddy" ]; then
      XCADDY_BIN="$_gobin/xcaddy"
      return 0
    fi
    _gopath="$("$GO_BIN" env GOPATH 2>/dev/null || true)"
    if [ -n "$_gopath" ] && [ -x "$_gopath/bin/xcaddy" ]; then
      XCADDY_BIN="$_gopath/bin/xcaddy"
      return 0
    fi
  fi

  if [ -n "${GOPATH:-}" ] && [ -x "$GOPATH/bin/xcaddy" ]; then
    XCADDY_BIN="$GOPATH/bin/xcaddy"
    return 0
  fi

  for candidate in \
    "$HOME/go/bin/xcaddy" \
    "$HOME/.local/bin/xcaddy" \
    /usr/local/bin/xcaddy
  do
    if [ -x "$candidate" ]; then
      XCADDY_BIN="$candidate"
      return 0
    fi
  done

  return 1
}

ensure_xcaddy() {
  if find_xcaddy; then
    return 0
  fi

  if command -v "$MISE_BIN" >/dev/null 2>&1; then
    echo "dotfiles-caddy-install: installing xcaddy via mise..." >&2
    "$MISE_BIN" use --global go:github.com/caddyserver/xcaddy/cmd/xcaddy@latest || true
    if find_xcaddy; then
      return 0
    fi
  fi

  if command -v "$GO_BIN" >/dev/null 2>&1; then
    echo "dotfiles-caddy-install: installing xcaddy via go install..." >&2
    "$GO_BIN" install github.com/caddyserver/xcaddy/cmd/xcaddy@latest || true
    if find_xcaddy; then
      return 0
    fi
  fi

  echo "dotfiles-caddy-install: Neither 'mise' nor 'go' is available to install xcaddy. Run: mise use --global go:github.com/caddyserver/xcaddy/cmd/xcaddy@latest or go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest" >&2
  exit 1
}

usage() {
  echo "Usage: dotfiles-caddy-install [OPTIONS]" >&2
  echo "  --clean     Wipe sites/ and snippets/ before syncing" >&2
  echo "  --reinstall Wipe sites/ and snippets/ before syncing (alias for --clean)" >&2
  echo "  --help      Show this help message" >&2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --clean|--reinstall)
      CLEAN_MODE="1"
      REINSTALL_MODE="1"
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      echo "dotfiles-caddy-install: unknown option $1" >&2
      usage
      exit 1
      ;;
  esac
done

build_caddy() {
  if [ -x "$CADDY_BIN" ] && "$CADDY_BIN" version 2>/dev/null | grep -q "$CADDY_VERSION"; then
    return 0
  fi
  ensure_xcaddy
  tmp_dir=$(mktemp -d)
  "$XCADDY_BIN" build "$CADDY_VERSION" --with github.com/caddy-dns/cloudflare --output "$tmp_dir/caddy"
  run_privileged install $INSTALL_OWNER_FLAGS -m 0755 "$tmp_dir/caddy" "$CADDY_BIN"
  rm -rf "$tmp_dir"
}

validate_config() {
  run_privileged /bin/sh -c "if [ -f \"$CADDY_ETC_DIR/env/cloudflare.env\" ]; then set -a; . \"$CADDY_ETC_DIR/env/cloudflare.env\" 2>/dev/null || true; set +a; fi; CF_API_TOKEN=\"\${CF_API_TOKEN:-placeholder-for-validation}\" ACME_EMAIL=\"\${ACME_EMAIL:-admin@example.internal}\" \"$CADDY_BIN\" validate --config \"$CADDY_ETC_DIR/Caddyfile\" --adapter caddyfile"
}

deploy_wrapper_and_daemon() {
  run_privileged mkdir -p "$CADDY_LIBEXEC_DIR" "$LAUNCHD_DIR"
  run_privileged install $INSTALL_OWNER_FLAGS -m 0755 "$DOTFILES_CADDY_SRC/caddy-start" "$CADDY_LIBEXEC_DIR/caddy-start"
  run_privileged install $INSTALL_OWNER_FLAGS -m 0644 "$DOTFILES_CADDY_SRC/local.caddy.plist" "$LAUNCHD_DIR/$LAUNCHD_LABEL.plist"

  if "$LAUNCHCTL_BIN" list "$LAUNCHD_LABEL" >/dev/null 2>&1; then
    run_privileged "$LAUNCHCTL_BIN" kickstart -k "system/$LAUNCHD_LABEL"
  else
    run_privileged "$LAUNCHCTL_BIN" bootstrap system "$LAUNCHD_DIR/$LAUNCHD_LABEL.plist"
  fi
}

warn_on_placeholder_acme_email "$(discover_acme_email)"

require_role
create_directories
if [ "$CLEAN_MODE" = "1" ] || [ "$REINSTALL_MODE" = "1" ]; then
  run_privileged rm -rf "$CADDY_ETC_DIR/sites" "$CADDY_ETC_DIR/snippets"
  create_directories
  echo "dotfiles-caddy-install: cleaned $CADDY_ETC_DIR/sites and $CADDY_ETC_DIR/snippets" >&2
fi
sync_config
bootstrap_cloudflare_env
build_caddy
validate_config
deploy_wrapper_and_daemon
