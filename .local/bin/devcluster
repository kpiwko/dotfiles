#!/bin/sh
# devcluster - Kubernetes (Kind) AI infrastructure management
# Supports roles: cluster

set -eu

K8S_DIR="${K8S_DIR:-$HOME/.config/k8s}"
CLUSTER_NAME="kind-ai-dev"
KIND_CONFIG="$K8S_DIR/kind-config.yaml"
KUSTOMIZE_DIR="$K8S_DIR"
DEVCLUSTER_KUBECONFIG="${DEVCLUSTER_KUBECONFIG:-$HOME/.kube/opencode-devcluster}"

usage() {
  echo "Usage: devcluster <command> [options]" >&2
  echo "" >&2
  echo "Commands:" >&2
  echo "  create    Create Kind cluster with AI infrastructure configuration" >&2
  echo "  up        Deploy kustomize manifests to cluster" >&2
  echo "  status    Show cluster and pod status" >&2
  echo "  logs      Show logs for a pod (use: logs <pod> [container])" >&2
  echo "  down      Stop cluster (preserve state)" >&2
  echo "  delete    Delete cluster completely" >&2
  echo "" >&2
  echo "Environment:" >&2
  echo "  K8S_DIR           Path to k8s manifests (default: ~/.config/k8s)" >&2
  echo "  DOTFILES_ROLES_FILE  Path to roles file (default: ~/.config/dotfiles/roles)" >&2
  exit 1
}

check_cluster_role() {
  if ! command -v dotfiles-role >/dev/null 2>&1; then
    echo "devcluster: error: dotfiles-role not found" >&2
    exit 1
  fi
  dotfiles-role has cluster || {
    echo "devcluster: error: cluster role not enabled" >&2
    echo "Run: dotfiles-role enable cluster" >&2
    exit 1
  }
}

check_kind() {
  if ! command -v kind >/dev/null 2>&1; then
    echo "devcluster: error: kind not found" >&2
    echo "Install with: brew install kind" >&2
    exit 1
  fi
}

check_kubectl() {
  if command -v devcluster-kubectl >/dev/null 2>&1; then
    KUBECTL_BIN="devcluster-kubectl"
  elif command -v kubectl >/dev/null 2>&1; then
    KUBECTL_BIN="kubectl"
  else
    echo "devcluster: error: kubectl not found" >&2
    echo "Install with: brew install kubernetes-cli" >&2
    exit 1
  fi
}

export_kubeconfig() {
  check_kind
  mkdir -p "$(dirname "$DEVCLUSTER_KUBECONFIG")"
  export KIND_EXPERIMENTAL_PROVIDER=podman
  kind export kubeconfig --name "$CLUSTER_NAME" --kubeconfig "$DEVCLUSTER_KUBECONFIG"
}

cmd_create() {
  check_cluster_role
  check_kind
  
  echo "Creating Kind cluster: $CLUSTER_NAME"
  
  if [ -f "$KIND_CONFIG" ]; then
    mkdir -p "$(dirname "$DEVCLUSTER_KUBECONFIG")"
    export KIND_EXPERIMENTAL_PROVIDER=podman
    kind create cluster --name "$CLUSTER_NAME" --config "$KIND_CONFIG" --kubeconfig "$DEVCLUSTER_KUBECONFIG"
    export_kubeconfig
  else
    echo "devcluster: error: kind config not found at $KIND_CONFIG" >&2
    exit 1
  fi
}

cmd_up() {
  if [ ! -f "$DEVCLUSTER_KUBECONFIG" ]; then
    if command -v kind >/dev/null 2>&1; then
      echo "Exporting kubeconfig to $DEVCLUSTER_KUBECONFIG..."
      export_kubeconfig || true
    fi
  fi

  check_kubectl
  
  if [ -f "$K8S_DIR/.env" ]; then
    # Load .env as fallback for any variable not already set in shell environment
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        \#*|"") continue ;;
        *=*)
          key="${line%%=*}"
          val="${line#*=}"
          key=$(echo "$key" | tr -d '[:space:]')
          val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^["'"'"']//' -e 's/["'"'"']$//')
          if [ -n "$key" ]; then
            eval ": \${$key:=\$val}"
          fi
          ;;
      esac
    done < "$K8S_DIR/.env"
  fi

  echo "Provisioning secrets for namespace ai-dev..."
  $KUBECTL_BIN create namespace ai-dev --dry-run=client -o yaml | $KUBECTL_BIN apply -f -

  postgres_user="${AI_DEV_POSTGRES_USER:-${DEVCLUSTER_POSTGRES_USER:-${POSTGRES_USER:-langfuse}}}"
  postgres_password="${AI_DEV_POSTGRES_PASSWORD:-${DEVCLUSTER_POSTGRES_PASSWORD:-${POSTGRES_PASSWORD:-postgresdevpass123}}}"
  clickhouse_user="${AI_DEV_CLICKHOUSE_USER:-${DEVCLUSTER_CLICKHOUSE_USER:-${CLICKHOUSE_USER:-langfuse}}}"
  clickhouse_password="${AI_DEV_CLICKHOUSE_PASSWORD:-${DEVCLUSTER_CLICKHOUSE_PASSWORD:-${CLICKHOUSE_PASSWORD:-clickhousedevpass123}}}"
  minio_root_user="${AI_DEV_MINIO_ROOT_USER:-${DEVCLUSTER_MINIO_ROOT_USER:-${MINIO_ROOT_USER:-langfuse}}}"
  minio_root_password="${AI_DEV_MINIO_ROOT_PASSWORD:-${DEVCLUSTER_MINIO_ROOT_PASSWORD:-${MINIO_ROOT_PASSWORD:-miniodevpass123}}}"
  redis_password="${AI_DEV_REDIS_PASSWORD:-${DEVCLUSTER_REDIS_PASSWORD:-${REDIS_PASSWORD:-redisdevpass123}}}"
  langfuse_secret_key="${AI_DEV_LANGFUSE_ENCRYPTION_KEY:-${DEVCLUSTER_LANGFUSE_ENCRYPTION_KEY:-${LANGFUSE_SECRET_KEY:-devsecretkey_0123456789abcdef0123456789abcdef}}}"
  langfuse_init_user_email="${AI_DEV_LANGFUSE_INIT_USER_EMAIL:-${DEVCLUSTER_LANGFUSE_INIT_USER_EMAIL:-${LANGFUSE_INIT_USER_EMAIL:-kpiwko@localhost}}}"
  langfuse_init_user_name="${AI_DEV_LANGFUSE_INIT_USER_NAME:-${DEVCLUSTER_LANGFUSE_INIT_USER_NAME:-${LANGFUSE_INIT_USER_NAME:-Karel Piwko}}}"
  langfuse_init_user_password="${AI_DEV_LANGFUSE_INIT_USER_PASSWORD:-${DEVCLUSTER_LANGFUSE_INIT_USER_PASSWORD:-${LANGFUSE_INIT_USER_PASSWORD:-langfusedevpass123}}}"
  langfuse_init_org_id="${AI_DEV_LANGFUSE_INIT_ORG_ID:-${DEVCLUSTER_LANGFUSE_INIT_ORG_ID:-${LANGFUSE_INIT_ORG_ID:-local-dev}}}"
  langfuse_init_org_name="${AI_DEV_LANGFUSE_INIT_ORG_NAME:-${DEVCLUSTER_LANGFUSE_INIT_ORG_NAME:-${LANGFUSE_INIT_ORG_NAME:-Local Dev}}}"
  langfuse_init_project_id="${AI_DEV_LANGFUSE_INIT_PROJECT_ID:-${DEVCLUSTER_LANGFUSE_INIT_PROJECT_ID:-${LANGFUSE_INIT_PROJECT_ID:-local-project}}}"
  langfuse_init_project_name="${AI_DEV_LANGFUSE_INIT_PROJECT_NAME:-${DEVCLUSTER_LANGFUSE_INIT_PROJECT_NAME:-${LANGFUSE_INIT_PROJECT_NAME:-Local Project}}}"
  langfuse_init_project_public_key="${AI_DEV_LANGFUSE_INIT_PROJECT_PUBLIC_KEY:-${DEVCLUSTER_LANGFUSE_INIT_PROJECT_PUBLIC_KEY:-${LANGFUSE_INIT_PROJECT_PUBLIC_KEY:-pk-lf-0123456789abcdef0123456789abcdef}}}"
  langfuse_init_project_secret_key="${AI_DEV_LANGFUSE_INIT_PROJECT_SECRET_KEY:-${DEVCLUSTER_LANGFUSE_INIT_PROJECT_SECRET_KEY:-${LANGFUSE_INIT_PROJECT_SECRET_KEY:-sk-lf-0123456789abcdef0123456789abcdef}}}"

  database_url="postgresql://${postgres_user}:${postgres_password}@postgres:5432/langfuse"
  direct_url="postgresql://${postgres_user}:${postgres_password}@postgres:5432/langfuse"
  clickhouse_url="http://${clickhouse_user}:${clickhouse_password}@clickhouse:8123"
  clickhouse_migration_url="clickhouse://${clickhouse_user}:${clickhouse_password}@clickhouse:9000/default"

  $KUBECTL_BIN create secret generic ai-dev-secrets \
    --namespace ai-dev \
    --from-literal=POSTGRES_USER="$postgres_user" \
    --from-literal=POSTGRES_PASSWORD="$postgres_password" \
    --from-literal=DATABASE_URL="$database_url" \
    --from-literal=DIRECT_URL="$direct_url" \
    --from-literal=CLICKHOUSE_USER="$clickhouse_user" \
    --from-literal=CLICKHOUSE_PASSWORD="$clickhouse_password" \
    --from-literal=CLICKHOUSE_URL="$clickhouse_url" \
    --from-literal=CLICKHOUSE_MIGRATION_URL="$clickhouse_migration_url" \
    --from-literal=MINIO_ROOT_USER="$minio_root_user" \
    --from-literal=MINIO_ROOT_PASSWORD="$minio_root_password" \
    --from-literal=REDIS_PASSWORD="$redis_password" \
    --from-literal=REDIS_AUTH="$redis_password" \
    --from-literal=LANGFUSE_SECRET_KEY="$langfuse_secret_key" \
    --from-literal=LANGFUSE_INIT_USER_EMAIL="$langfuse_init_user_email" \
    --from-literal=LANGFUSE_INIT_USER_NAME="$langfuse_init_user_name" \
    --from-literal=LANGFUSE_INIT_USER_PASSWORD="$langfuse_init_user_password" \
    --from-literal=LANGFUSE_INIT_ORG_ID="$langfuse_init_org_id" \
    --from-literal=LANGFUSE_INIT_ORG_NAME="$langfuse_init_org_name" \
    --from-literal=LANGFUSE_INIT_PROJECT_ID="$langfuse_init_project_id" \
    --from-literal=LANGFUSE_INIT_PROJECT_NAME="$langfuse_init_project_name" \
    --from-literal=LANGFUSE_INIT_PROJECT_PUBLIC_KEY="$langfuse_init_project_public_key" \
    --from-literal=LANGFUSE_INIT_PROJECT_SECRET_KEY="$langfuse_init_project_secret_key" \
    --dry-run=client -o yaml | $KUBECTL_BIN apply -f -

  $KUBECTL_BIN create secret generic workspace-mcp-secrets \
    --namespace ai-dev \
    --from-literal=GOOGLE_OAUTH_CLIENT_ID="${AI_DEV_GOOGLE_OAUTH_CLIENT_ID:-${DEVCLUSTER_GOOGLE_OAUTH_CLIENT_ID:-${GOOGLE_OAUTH_CLIENT_ID:-}}}" \
    --from-literal=GOOGLE_OAUTH_CLIENT_SECRET="${AI_DEV_GOOGLE_OAUTH_CLIENT_SECRET:-${DEVCLUSTER_GOOGLE_OAUTH_CLIENT_SECRET:-${GOOGLE_OAUTH_CLIENT_SECRET:-}}}" \
    --dry-run=client -o yaml | $KUBECTL_BIN apply -f -

  echo "Deploying kustomize manifests..."
  
  if [ -d "$KUSTOMIZE_DIR" ]; then
    $KUBECTL_BIN apply -k "$KUSTOMIZE_DIR"
  else
    echo "devcluster: error: kustomize dir not found at $KUSTOMIZE_DIR" >&2
    exit 1
  fi
}

cmd_status() {
  check_kubectl
  check_kind
  
  echo "=== Cluster Nodes ==="
  kind get clusters 2>/dev/null || true
  echo ""
  $KUBECTL_BIN get nodes
  
  echo ""
  echo "=== Pods (ai-dev namespace) ==="
  $KUBECTL_BIN get pods -n ai-dev
}

cmd_logs() {
  check_kubectl
  
  if [ $# -lt 1 ]; then
    echo "Usage: devcluster logs <pod> [container]" >&2
    exit 1
  fi
  
  pod="$1"
  container="${2:-}"
  
  if [ -n "$container" ]; then
    $KUBECTL_BIN logs -n ai-dev "$pod" -c "$container" --tail=100 --follow
  else
    $KUBECTL_BIN logs -n ai-dev "$pod" --tail=100 --follow
  fi
}

cmd_down() {
  check_kind
  check_kubectl
  
  echo "Stopping cluster: $CLUSTER_NAME"
  export_kubeconfig
  # Scale down deployments
  $KUBECTL_BIN scale --replicas=0 -n ai-dev --all
}

cmd_delete() {
  check_kind
  
  echo "Deleting cluster: $CLUSTER_NAME"
  export KIND_EXPERIMENTAL_PROVIDER=podman
  kind delete cluster --name "$CLUSTER_NAME" --kubeconfig "$DEVCLUSTER_KUBECONFIG" 2>/dev/null || kind delete cluster --name "$CLUSTER_NAME"
  rm -f "$DEVCLUSTER_KUBECONFIG"
}

# Main
[ $# -ge 1 ] || usage

action="$1"; shift || true

case "$action" in
  create) cmd_create ;;
  up) cmd_up ;;
  status) cmd_status ;;
   logs) cmd_logs "$@" ;;
  down) cmd_down ;;
  delete) cmd_delete ;;
  *) usage ;;
esac
