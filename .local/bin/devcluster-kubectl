#!/usr/bin/env bash
set -euo pipefail

# Deliberately do not read DEVCLUSTER_KUBECONFIG: this wrapper is an isolated
# interface to the devcluster, not a generic kubectl proxy.
KUBECONFIG_FILE="${HOME}/.kube/opencode-devcluster"
CONTEXT="devcluster"

# Don't allow callers to escape to another kubeconfig/context.
for arg in "$@"; do
    case "$arg" in
        --kubeconfig|--kubeconfig=*|--context|--context=*)
            echo "error: overriding kubeconfig or context is not allowed" >&2
            exit 1
            ;;
    esac
done

if [[ ! -f "$KUBECONFIG_FILE" ]]; then
    echo "error: kubeconfig not found: $KUBECONFIG_FILE" >&2
    exit 1
fi

exec kubectl \
    --kubeconfig="$KUBECONFIG_FILE" \
    --context="$CONTEXT" \
    "$@"
