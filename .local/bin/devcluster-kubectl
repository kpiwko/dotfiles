#!/usr/bin/env python3
"""Run kubectl only against the isolated devcluster context."""

from __future__ import annotations

import os
import sys
from pathlib import Path


KUBECONFIG_PATH = Path.home() / ".kube" / "opencode-devcluster"
CONTEXT = "devcluster"


def main(args: list[str]) -> int:
    if any(
        arg == "--kubeconfig"
        or arg.startswith("--kubeconfig=")
        or arg == "--context"
        or arg.startswith("--context=")
        for arg in args
    ):
        print("error: overriding kubeconfig or context is not allowed", file=sys.stderr)
        return 1
    if not KUBECONFIG_PATH.is_file():
        print(f"error: kubeconfig not found: {KUBECONFIG_PATH}", file=sys.stderr)
        return 1
    os.execvp(
        "kubectl",
        ["kubectl", f"--kubeconfig={KUBECONFIG_PATH}", f"--context={CONTEXT}", *args],
    )
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
