#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "mlflow>=3.17.0,<4",
# ]
# ///

from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import mlflow
from mlflow import MlflowClient
from mlflow.entities import Trace


RELATIVE_TIME_RE = re.compile(
    r"^-(?P<value>\d+)(?P<unit>[smhdw])$",
    re.IGNORECASE,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Download traces from MLflow.",
        epilog=(
            "Examples:\n"
            "  mlflow-traces.py trace tr-012345...\n"
            "  mlflow-traces.py experiment 7\n"
            "  mlflow-traces.py experiment 7 --since=-12h\n"
            "  mlflow-traces.py experiment 7 --since=-12h --aggregate\n"
            "  mlflow-traces.py experiment 7 --since 2026-10-06 --until 2026-10-07\n"
            "\n"
            "Run '<command> --help' for command-specific options."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        "--tracking-uri",
        help="MLflow tracking URI. Defaults to MLFLOW_TRACKING_URI.",
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
        metavar="COMMAND",
    )

    trace_parser = subparsers.add_parser(
        "trace",
        help="Download a single trace.",
        description="Download a single MLflow trace as JSON.",
    )
    trace_parser.add_argument(
        "trace_id",
        help="MLflow trace ID, e.g. tr-012345...",
    )
    trace_parser.add_argument(
        "--compat",
        action="store_true",
        help=(
            "Modify downloaded trace(s) for MLflow Evaluation Dataset compatibility "
            "(wraps non-dict root inputs/outputs into dicts, see "
            "https://github.com/mlflow/mlflow/issues/24709)."
        ),
    )
    trace_parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="Output file. Defaults to <trace-id>.json.",
    )

    experiment_parser = subparsers.add_parser(
        "experiment",
        help="Download traces from an experiment.",
        description=(
            "Download traces from an MLflow experiment.\n\n"
            "Time values may be absolute ISO-8601 timestamps or relative values "
            "such as -12h, -30m, or -7d."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    experiment_parser.add_argument(
        "experiment",
        help="Experiment ID or experiment name.",
    )
    experiment_parser.add_argument(
        "-s",
        "--since",
        help=(
            "Only include traces at or after this time. "
            "Examples: --since=-12h, --since 2026-10-07T08:00:00+02:00."
        ),
    )
    experiment_parser.add_argument(
        "-u",
        "--until",
        help=(
            "Only include traces before or at this time. "
            "Examples: --until=-1h, --until 2026-10-07T10:00:00+02:00."
        ),
    )
    experiment_parser.add_argument(
        "--session",
        "--session-id",
        dest="session_id",
        help="Only include traces matching this session ID (e.g. ses_...).",
    )
    experiment_parser.add_argument(
        "--compat",
        action="store_true",
        help=(
            "Modify downloaded trace(s) for MLflow Evaluation Dataset compatibility "
            "(wraps non-dict root inputs/outputs into dicts, see "
            "https://github.com/mlflow/mlflow/issues/24709)."
        ),
    )
    experiment_parser.add_argument(
        "-a",
        "--aggregate",
        action="store_true",
        help="Write all matching traces into one JSON array.",
    )
    experiment_parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help=(
            "Output file with --aggregate; otherwise output directory. "
            "Defaults to traces.json or ./traces/."
        ),
    )

    return parser.parse_args()


def parse_time(value: str) -> datetime:
    relative = RELATIVE_TIME_RE.fullmatch(value)

    if relative:
        amount = int(relative.group("value"))
        unit = relative.group("unit").lower()

        delta = {
            "s": timedelta(seconds=amount),
            "m": timedelta(minutes=amount),
            "h": timedelta(hours=amount),
            "d": timedelta(days=amount),
            "w": timedelta(weeks=amount),
        }[unit]

        return datetime.now(timezone.utc) - delta

    try:
        timestamp = value.replace("Z", "+00:00")
        parsed = datetime.fromisoformat(timestamp)
    except ValueError as exc:
        raise ValueError(
            f"Invalid time value: {value!r}. "
            "Use e.g. -12h or 2026-10-07T08:00:00+02:00."
        ) from exc

    if parsed.tzinfo is None:
        parsed = parsed.astimezone()

    return parsed


def datetime_to_epoch_ms(value: datetime) -> int:
    return int(value.timestamp() * 1000)


def normalize_dataset_value(value: object, fallback_key: str = "input") -> dict:
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except json.JSONDecodeError:
            pass

    if isinstance(value, dict):
        return value

    return {fallback_key: value}


def make_trace_dataset_compatible(trace_dict: dict) -> dict:
    data = trace_dict.get("data", {})
    spans = data.get("spans") or []

    for span in spans:
        attributes = span.get("attributes", {})
        for key, fallback in (
            ("mlflow.spanInputs", "input"),
            ("input.value", "input"),
            ("mlflow.spanOutputs", "output"),
            ("output.value", "output"),
        ):
            if key in attributes:
                attributes[key] = json.dumps(
                    normalize_dataset_value(attributes[key], fallback),
                    ensure_ascii=False,
                )

        for key, fallback in (("inputs", "input"), ("outputs", "output")):
            if key in span:
                span[key] = normalize_dataset_value(span[key], fallback)

    if "request" in data:
        data["request"] = normalize_dataset_value(data["request"], "input")
    if "response" in data:
        data["response"] = normalize_dataset_value(data["response"], "output")

    return trace_dict


def trace_to_dict(trace: Trace, compat: bool = False) -> dict:
    trace_dict = json.loads(trace.to_json())
    return make_trace_dataset_compatible(trace_dict) if compat else trace_dict


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    with path.open("w", encoding="utf-8") as file:
        json.dump(
            value,
            file,
            indent=2,
            ensure_ascii=False,
        )
        file.write("\n")


def resolve_experiment_id(
    client: MlflowClient,
    experiment: str,
) -> str:
    if experiment.isdigit():
        resolved = client.get_experiment(experiment)
    else:
        resolved = client.get_experiment_by_name(experiment)

    if resolved is None:
        raise ValueError(f"Experiment not found: {experiment}")

    return resolved.experiment_id


def download_trace(
    client: MlflowClient,
    trace_id: str,
    output: Path | None,
    compat: bool = False,
) -> None:
    trace = client.get_trace(trace_id)

    destination = output or Path(f"{trace_id}.json")
    write_json(destination, trace_to_dict(trace, compat=compat))

    print(f"Wrote {destination}")


def build_time_filter(
    since: datetime | None,
    until: datetime | None,
    session_id: str | None = None,
) -> str | None:
    filters: list[str] = []

    if since is not None:
        filters.append(
            f"trace.timestamp_ms >= {datetime_to_epoch_ms(since)}"
        )

    if until is not None:
        filters.append(
            f"trace.timestamp_ms <= {datetime_to_epoch_ms(until)}"
        )

    if session_id is not None:
        escaped_session = session_id.replace("'", "\\'")
        filters.append(
            f"metadata.`mlflow.trace.session` = '{escaped_session}'"
        )

    if not filters:
        return None

    return " AND ".join(filters)


def search_all_traces(
    client: MlflowClient,
    experiment_id: str,
    since: datetime | None,
    until: datetime | None,
    session_id: str | None = None,
) -> list[Trace]:
    filter_string = build_time_filter(since, until, session_id)

    traces: list[Trace] = []
    page_token: str | None = None

    while True:
        page = client.search_traces(
            locations=[experiment_id],
            filter_string=filter_string,
            max_results=500,
            order_by=["timestamp_ms ASC"],
            page_token=page_token,
            include_spans=True,
        )

        traces.extend(page)

        if not page.token:
            break

        page_token = page.token

    return traces


def download_experiment(
    client: MlflowClient,
    experiment: str,
    since: str | None,
    until: str | None,
    aggregate: bool,
    output: Path | None,
    session_id: str | None = None,
    compat: bool = False,
) -> None:
    experiment_id = resolve_experiment_id(client, experiment)

    since_datetime = parse_time(since) if since else None
    until_datetime = parse_time(until) if until else None

    if (
        since_datetime is not None
        and until_datetime is not None
        and since_datetime > until_datetime
    ):
        raise ValueError("--since must be earlier than --until")

    traces = search_all_traces(
        client=client,
        experiment_id=experiment_id,
        since=since_datetime,
        until=until_datetime,
        session_id=session_id,
    )

    print(f"Found {len(traces)} trace(s)")

    if aggregate:
        destination = output or Path("traces.json")

        write_json(
            destination,
            [trace_to_dict(trace, compat=compat) for trace in traces],
        )

        print(f"Wrote {destination}")
        return

    output_dir = output or Path("traces")
    output_dir.mkdir(parents=True, exist_ok=True)

    for trace in traces:
        trace_id = trace.info.trace_id
        destination = output_dir / f"{trace_id}.json"

        write_json(
            destination,
            trace_to_dict(trace, compat=compat),
        )

    print(f"Wrote {len(traces)} trace(s) to {output_dir}/")


def main() -> int:
    args = parse_args()

    if args.tracking_uri:
        mlflow.set_tracking_uri(args.tracking_uri)

    client = MlflowClient()

    try:
        match args.command:
            case "trace":
                download_trace(
                    client=client,
                    trace_id=args.trace_id,
                    output=args.output,
                    compat=args.compat,
                )

            case "experiment":
                download_experiment(
                    client=client,
                    experiment=args.experiment,
                    since=args.since,
                    until=args.until,
                    aggregate=args.aggregate,
                    output=args.output,
                    session_id=args.session_id,
                    compat=args.compat,
                )

    except (ValueError, mlflow.MlflowException) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
