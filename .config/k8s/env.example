# Kubernetes Environment Variables
# Copy this file to .env and fill in the values

# Langfuse Configuration
LANGFUSE_SECRET_KEY=your-secret-key-here
LANGFUSE_AUDIT_LOGS_ENABLED=true

# PostgreSQL Configuration
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=langfuse

# ClickHouse Configuration
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=your-clickhouse-password-here

# Redis Configuration
REDIS_PASSWORD=your-redis-password-here

# MinIO Configuration
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=your-minio-password-here

# MCP Server Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here

# Cluster Configuration
CLUSTER_NAME=kind-ai-dev
K8S_NAMESPACE=ai-dev
