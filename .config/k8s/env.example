# Fallback inputs for `devcluster up`.
#
# Copy to ~/.config/k8s/.env and replace the empty values locally. This file is
# intentionally key=value only: do not use `export`, command substitutions, or
# shell quoting. Never commit ~/.config/k8s/.env or credential material.
#
# For the direct AgentGateway/provider variables below, a non-empty same-name
# shell export takes precedence; `.env` supplies that variable only when it is
# unset or empty. Workspace OAuth aliases are resolved after `.env` loads, so a
# value in this file for a higher-priority AI_DEV_* alias overrides a shell value
# set only through a lower-priority alias.

# Required AgentGateway provider inputs. `devcluster up` validates all of these
# after the MLflow migration and before it starts the runtime.
# ENMAAS_URL is the EnMaaS OpenAI-compatible API base URL (including /v1).
ENMAAS_KEY=
ENMAAS_URL=
OPENAI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=
AGENTGATEWAY_API_KEY=
# Fixed MLflow experiment used by OpenCode and AgentGateway telemetry.
# 23 is the agreed target for every emitter. The OpenCode service is
# configured to send x-mlflow-experiment-id: 23 itself via the otlpHeaders
# plugin option in ~/.config/opencode/opencode.jsonc, effective after service
# restart; this value feeds only AgentGateway's secret-sourced header. Before
# `devcluster up`, make sure it is 23 here (or in the shell, which takes
# precedence) so both emitters land in experiment 23.
MLFLOW_EXPERIMENT_ID=23

# Required Vertex source file. Set an absolute path to this exact readable host
# file, with your home directory expanded (do not use `$HOME` in this .env
# file):
#   <your-home>/.config/opencode/itpc-ca-993e2467de-opencode-vertex.json
# Its contents are copied into the Kubernetes Secret; the host path is never
# passed into the Gateway Job.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Workspace MCP OAuth inputs. Prefer these AI_DEV_* names. The
# supported fallback order is AI_DEV_GOOGLE_OAUTH_* (shown) then
# AI_DEV_GOOGLE_AUTH_*, DEVCLUSTER_GOOGLE_OAUTH_*, and GOOGLE_OAUTH_*.
# Leave every alias in that hierarchy unset or empty to create the Workspace
# MCP secret with empty values; empty shown AI_DEV_* values do not prevent a
# lower-priority shell alias from being selected.
AI_DEV_GOOGLE_OAUTH_CLIENT_ID=
AI_DEV_GOOGLE_OAUTH_CLIENT_SECRET=
