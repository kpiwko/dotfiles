# Kubernetes Environment Variables
# Primary configuration is via shell environment variables (e.g. in ~/.config/zsh/10-env.zsh or secrets.zsh).
# Supports AI_DEV_* (highest priority) and DEVCLUSTER_* prefixes to prevent collisions in global shell environments,
# falling back to unprefixed variables and built-in defaults.
# devcluster up auto-provisions secrets with sensible local dev defaults if unset.
# Optionally, copy this file to ~/.config/k8s/.env as a fallback.

# Langfuse Configuration
# Hierarchy: AI_DEV_LANGFUSE_ENCRYPTION_KEY -> DEVCLUSTER_LANGFUSE_ENCRYPTION_KEY -> LANGFUSE_SECRET_KEY
AI_DEV_LANGFUSE_ENCRYPTION_KEY=devsecretkey_0123456789abcdef0123456789abcdef
NEXT_PUBLIC_AUDIT_LOGS_ENABLED=true

# Langfuse Headless Initialization
# Hierarchy: AI_DEV_LANGFUSE_INIT_* -> DEVCLUSTER_LANGFUSE_INIT_* -> LANGFUSE_INIT_*
AI_DEV_LANGFUSE_INIT_USER_EMAIL=kpiwko@localhost
AI_DEV_LANGFUSE_INIT_USER_NAME=Karel Piwko
AI_DEV_LANGFUSE_INIT_USER_PASSWORD=langfusedevpass123
AI_DEV_LANGFUSE_INIT_ORG_ID=local-dev
AI_DEV_LANGFUSE_INIT_ORG_NAME=Local Dev
AI_DEV_LANGFUSE_INIT_PROJECT_ID=local-project
AI_DEV_LANGFUSE_INIT_PROJECT_NAME=Local Project
AI_DEV_LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-0123456789abcdef0123456789abcdef
AI_DEV_LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-0123456789abcdef0123456789abcdef

# PostgreSQL Configuration
# Hierarchy: AI_DEV_POSTGRES_* -> DEVCLUSTER_POSTGRES_* -> POSTGRES_*
AI_DEV_POSTGRES_USER=langfuse
AI_DEV_POSTGRES_PASSWORD=postgresdevpass123
AI_DEV_POSTGRES_DB=langfuse

# ClickHouse Configuration
# Hierarchy: AI_DEV_CLICKHOUSE_* -> DEVCLUSTER_CLICKHOUSE_* -> CLICKHOUSE_*
AI_DEV_CLICKHOUSE_USER=langfuse
AI_DEV_CLICKHOUSE_PASSWORD=clickhousedevpass123

# Redis Configuration
# Hierarchy: AI_DEV_REDIS_* -> DEVCLUSTER_REDIS_* -> REDIS_*
AI_DEV_REDIS_PASSWORD=redisdevpass123

# MinIO Configuration
# Hierarchy: AI_DEV_MINIO_* -> DEVCLUSTER_MINIO_* -> MINIO_*
AI_DEV_MINIO_ROOT_USER=langfuse
AI_DEV_MINIO_ROOT_PASSWORD=miniodevpass123

# MCP Server Configuration (Workspace MCP Google OAuth)
# Hierarchy: AI_DEV_GOOGLE_OAUTH_* -> DEVCLUSTER_GOOGLE_OAUTH_* -> GOOGLE_OAUTH_*
AI_DEV_GOOGLE_OAUTH_CLIENT_ID=
AI_DEV_GOOGLE_OAUTH_CLIENT_SECRET=

# Cluster Configuration
CLUSTER_NAME=kind-ai-dev
K8S_NAMESPACE=ai-dev
