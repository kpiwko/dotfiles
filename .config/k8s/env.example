# Kubernetes Environment Variables
# Primary configuration is via shell environment variables (e.g. in ~/.config/zsh/10-env.zsh or secrets.zsh).
# Supports AI_DEV_* (highest priority) and DEVCLUSTER_* prefixes to prevent collisions in global shell environments,
# falling back to unprefixed variables and built-in defaults.
# devcluster up auto-provisions secrets with sensible local dev defaults if unset.
# Optionally, copy this file to ~/.config/k8s/.env as a fallback.

# MCP Server Configuration (Workspace MCP Google OAuth)
# Hierarchy: AI_DEV_GOOGLE_OAUTH_* -> DEVCLUSTER_GOOGLE_OAUTH_* -> GOOGLE_OAUTH_*
AI_DEV_GOOGLE_OAUTH_CLIENT_ID=
AI_DEV_GOOGLE_OAUTH_CLIENT_SECRET=

# Cluster Configuration
DEVCLUSTER_CPUS=8
DEVCLUSTER_MEMORY_GIB=16
DEVCLUSTER_DISK_GIB=100
# Sizing overrides apply when the Lima VM is first created. Recreate the VM to
# change CPU or memory sizing later.
K8S_NAMESPACE=ai-dev
