# Kubernetes Environment Variables
# Primary configuration is via shell environment variables (e.g. in ~/.config/zsh/10-env.zsh or secrets.zsh).
# dotfiles-cluster up auto-provisions secrets with sensible local dev defaults if unset.
# Optionally, copy this file to ~/.config/k8s/.env as a fallback.

# Langfuse Configuration
LANGFUSE_SECRET_KEY=devsecretkey_0123456789abcdef0123456789abcdef
NEXT_PUBLIC_AUDIT_LOGS_ENABLED=true

# PostgreSQL Configuration
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=postgresdevpass123
POSTGRES_DB=langfuse

# ClickHouse Configuration
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=clickhousedevpass123

# Redis Configuration
REDIS_PASSWORD=redisdevpass123

# MinIO Configuration
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=miniodevpass123

# MCP Server Configuration (Workspace MCP Google OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Cluster Configuration
CLUSTER_NAME=kind-ai-dev
K8S_NAMESPACE=ai-dev
