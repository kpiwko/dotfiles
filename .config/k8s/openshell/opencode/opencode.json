{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/usr/local/share/opencode/plugins/opencode-plugin-otel",
      "options": {
        "enabled": true,
        "protocol": "http/protobuf",
        "endpoint": "{env:OPENCODE_OTLP_ENDPOINT}",
        "otlpHeaders": "x-mlflow-experiment-id=23",
        "tracePropagationProviders": [
          "agentgateway"
        ],
        "disabledMetrics": [
          "cost.usage",
          "session.cost.total"
        ]
      }
    }
  ],
  "providers": {
    "agentgateway": {
      "name": "AgentGateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:AGENTGATEWAY_BASE_URL}",
        "apiKey": "{env:AGENTGATEWAY_API_KEY}"
      },
      "models": {
        "illusionist": {
          "modelID": "illusionist",
          "name": "Illusionist (DeepSeek V4.1 Flash)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 350000,
            "output": 64000
          }
        }
      }
    }
  },
  "model": "agentgateway/illusionist"
}
