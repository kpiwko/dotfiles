# Copied to /usr/local/etc/caddy/env/cloudflare.env automatically by
# dotfiles-caddy-install the first time it runs (never overwritten after
# that). Fill in a real Cloudflare API token scoped to Zone:DNS:Edit for
# the zone(s) used by your Caddy sites, then restart Caddy.
CF_API_TOKEN=changeme

# ACME email for Let's Encrypt certificate notifications.
# Hierarchy: DNS_ACME_EMAIL > ACME_EMAIL > git config --get user.email
ACME_EMAIL=you@example.com
