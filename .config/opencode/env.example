# OpenCode environment configuration
# Source equivalent values from your shell configuration. Never commit real secrets.

# OpenAI
export OPENAI_API_KEY="sk-..."

# oMLX (OpenAI-compatible; URL includes /v1)
export OMLX_BASE_URL="https://llm.example.com/v1"
export OMLX_API_KEY="dummy-key"

# LiteMaaS (OpenAI-compatible; URL includes /v1)
export LITEMAAS_BASE_URL="https://litemaas.example.com/v1"
export LITEMAAS_API_KEY="..."

# Langfuse OpenCode observability plugin
# Use the base Langfuse host, not /api/public/otel.
export LANGFUSE_PUBLIC_KEY="pk-lf-..."
export LANGFUSE_SECRET_KEY="sk-lf-..."
export LANGFUSE_BASEURL="https://tracing.example.com"
export LANGFUSE_ENVIRONMENT="development"
# Optional
# export LANGFUSE_USER_ID="your-user-id"

# Google Vertex AI (used by architect/plan where configured)
# export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/opencode/vertex.json"

# MCP services
export CONTEXT7_API_KEY="ctx7sk-..."
export NOTEBOOKLM_MCP_URL="http://localhost:17980/mcp"
export WORKSPACE_MCP_URL="http://localhost:17981/mcp"

# Atlassian MCP uses the interactive OAuth flow managed by OpenCode.
