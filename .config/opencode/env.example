# OpenCode Environment Configuration
# Copy this file to .env.local or source it in your shell environment.
# Do NOT commit .env.local or real secrets to version control.

# ============================================
# Profile Selection
# ============================================
# Set DOTFILES_PROFILE to one of: dev, cluster, ai-server
#
# dev: Local development (default)
#   - Langfuse: http://localhost:3000
#   - MCP NotebookLM: http://localhost:17980
#   - MCP Workspace: http://localhost:17981
#
# cluster: Kubernetes (devcluster / Kind)
#   - Langfuse: http://localhost:17900
#   - MCP NotebookLM: http://localhost:17980
#   - MCP Workspace: http://localhost:17981
#   - Uses manifests under ~/.config/k8s/
#
# ai-server: Dedicated AI server
#   - Langfuse: http://ai-server.local:3000
#   - MCP NotebookLM: http://ai-server.local:17980
#   - MCP Workspace: http://ai-server.local:17981

export DOTFILES_PROFILE="dev"

# ============================================
# OpenTelemetry & Langfuse Tracing
# ============================================

# OTEL Exporter Endpoint - Update with your actual endpoint or tracing domain
# For devcluster: "http://localhost:17900/api/public/otel"
# For ai-server / custom domain: "https://<your-tracing-domain>/api/public/otel"
export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:17900/api/public/otel"

# OTEL Protocol
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"

# Enable traces only (disable metrics and logs)
export OTEL_TRACES_EXPORTER="otlp"
export OTEL_METRICS_EXPORTER="none"
export OTEL_LOGS_EXPORTER="none"

# Authorization Header
# Generate with: export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic $(printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64),x-langfuse-ingestion-version=4"
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic $(printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64),x-langfuse-ingestion-version=4"

# Langfuse API Credentials
export LANGFUSE_PUBLIC_KEY="pk-lf-0123456789abcdef0123456789abcdef"
export LANGFUSE_SECRET_KEY="sk-lf-0123456789abcdef0123456789abcdef"
export LANGFUSE_BASEURL="http://localhost:17900"

# ============================================
# LLM Provider Configuration
# ============================================

# OpenAI Provider (for GPT models)
export OPENAI_API_KEY="sk-..."

# oMLX Provider (Local / remote OpenAI-compatible LLM endpoint)
export OMLX_BASE_URL="https://llm.example.com/v1"
export OMLX_API_KEY="dummy-key"

# Google Vertex AI (optional path to GCP service account key JSON)
# export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/opencode/vertex.json"

# ============================================
# MCP (Model Context Protocol) Services
# ============================================

# Context7 MCP API Key
export CONTEXT7_API_KEY="ctx7sk-..."

# Note:
# - Atlassian MCP uses interactive OAuth 2.0 PKCE auth flow managed directly by OpenCode.
# - Google Workspace MCP runs inside devcluster (http://localhost:17981/mcp).
#   OAuth credentials (AI_DEV_GOOGLE_OAUTH_CLIENT_ID / SECRET) are consumed by
#   the devcluster workspace-mcp pod, not directly by OpenCode.
