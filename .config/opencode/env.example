# OpenCode environment configuration
# Source equivalent values from your shell configuration. Never commit real secrets.

# OpenAI
export OPENAI_API_KEY="sk-..."

# EnMaaS (OpenAI-compatible; URL includes /v1)
# ENMAAS_KEY is read by the MLflow gateway reconciler; keep the value local.
export ENMAAS_URL="https://api.enmaas.devshift.net/v1"
export ENMAAS_KEY="replace-with-enmaas-key"
# Compatibility aliases for tools that use the longer names.
export ENMAAS_BASE_URL="$ENMAAS_URL"
export ENMAAS_API_KEY="$ENMAAS_KEY"

# MLflow AI Gateway
export MLFLOW_GATEWAY_BASE_URL="https://mlflow.fous.ai"
# Required only when the MLflow control plane requires API-key auth.
export MLFLOW_GATEWAY_API_KEY="replace-with-mlflow-gateway-key"

# oMLX (OpenAI-compatible; URL includes /v1)
export OMLX_BASE_URL="https://llm.example.com/v1"
export OMLX_API_KEY="dummy-key"

# LiteMaaS (OpenAI-compatible; URL includes /v1)
export LITEMAAS_BASE_URL="https://litemaas.example.com/v1"
export LITEMAAS_API_KEY="..."

# MLflow OpenCode Tracing
export MLFLOW_TRACKING_URI="https://mlflow.example.com"
export MLFLOW_EXPERIMENT_ID="0"
export OPENCODE_ENABLE_TELEMETRY="1"
export OPENCODE_OTLP_ENDPOINT="https://otel.example.internal"
export OPENCODE_OTLP_PROTOCOL="http/protobuf"
export OPENCODE_OTLP_HEADERS="x-mlflow-experiment-id=$MLFLOW_EXPERIMENT_ID"
export OPENCODE_RESOURCE_ATTRIBUTES="service.name=opencode,service.namespace=dotfiles"
export OPENCODE_DISABLE_LOGS="1"
# export MLFLOW_OPENCODE_DEBUG="true"

# Google Vertex AI (used by architect/plan where configured)
# export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/opencode/vertex.json"
export VERTEX_PROJECT="replace-with-gcp-project"
export VERTEX_LOCATION="global"

# MCP services
export CONTEXT7_API_KEY="ctx7sk-..."
export NOTEBOOKLM_MCP_URL="http://localhost:17980/mcp"
export WORKSPACE_MCP_URL="http://localhost:17981/mcp"

# Atlassian MCP uses the interactive OAuth flow managed by OpenCode.
