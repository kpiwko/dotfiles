{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{env:HOME}/.config/opencode/AGENTS.md"
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    {
      "package": "@devtheops/opencode-plugin-otel",
      "options": {
        "enabled": true,
        "protocol": "http/protobuf",
        "endpoint": "{env:OPENCODE_OTLP_ENDPOINT}",
        "tracePropagationProviders": [
          "agentgateway",
          "agentgateway-gemini"
        ],
        "disabledMetrics": [
          "cost.usage",
          "session.cost.total"
        ]
      }
    },
    "@mohak34/opencode-notifier"
  ],
  "mcp": {
    "servers": {
      "Atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      },
      "notebooklm": {
        "type": "remote",
        "url": "{env:NOTEBOOKLM_MCP_URL}"
      },
      "workspace": {
        "type": "remote",
        "url": "{env:WORKSPACE_MCP_URL}"
      }
    }
  },
  "permissions": [
    {
      "action": "Atlassian_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": 8000
  },
  "providers": {
    "agentgateway": {
      "name": "AgentGateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:AGENTGATEWAY_BASE_URL}",
        "apiKey": "{env:AGENTGATEWAY_API_KEY}"
      },
      "models": {
        "omnipower": {
          "modelID": "omnipower",
          "name": "Omnipower (Claude Opus 5.5)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 350000,
            "output": 64000
          }
        },
        "architect": {
          "modelID": "architect",
          "name": "Architect (GPT-6.1 Sol)",
          "package": "@opencode/ai/providers/openai-compatible/responses",
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": [
            {
              "id": "low",
              "settings": {"reasoningEffort": "low"}
            },
            {
              "id": "medium",
              "settings": {"reasoningEffort": "medium"}
            },
            {
              "id": "high",
              "settings": {"reasoningEffort": "high"}
            },
            {
              "id": "xhigh",
              "settings": {"reasoningEffort": "xhigh"}
            }
          ],
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh"]
            }
          },
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "worker": {
          "modelID": "worker",
          "name": "Worker (GLM 5.3)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "illusionist": {
          "modelID": "illusionist",
          "name": "Illusionist (DeepSeek V4.1 Flash)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "reviewer": {
          "modelID": "reviewer",
          "name": "Reviewer (Claude Sonnet 5.5)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 250000,
            "output": 16000
          }
        },
        "spade": {
          "modelID": "spade",
          "name": "Spade (GPT-6 Luna)",
          "package": "@opencode/ai/providers/openai-compatible/responses",
          "settings": {
            "reasoningEffort": "medium"
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          },
          "limit": {
            "context": 250000,
            "output": 32000
          }
        }
      }
    },
    "agentgateway-gemini": {
      "name": "AgentGateway Gemini",
      "package": "@opencode/ai/providers/google",
      "settings": {
        "baseURL": "{env:AGENTGATEWAY_GEMINI_BASE_URL}",
        "apiKey": "{env:AGENTGATEWAY_API_KEY}"
      },
      "headers": {
        "Authorization": "Bearer {env:AGENTGATEWAY_API_KEY}"
      },
      "models": {
        "gemini": {
          "modelID": "gemini",
          "name": "Gemini 3.8 Flash (Vertex via AgentGateway)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 250000,
            "output": 16000
          }
        }
      }
    }
  },
  "default_agent": "orchestrator",
  "model": "agentgateway/architect"
}
