# Git-pilot Harbor trial image (git-pilot-v1, "bounded packaging offline" unit).
#
# SCOPE LABEL: basic Git-task END-STATE pilot. The verifier measures the
# final repository state only; procedure_attempt_coverage is not_measured
# (no attempt observation, no denied-destructive-attempt coverage, no
# holdout or golden-history claims).
#
# FROM the reviewed agent-eval-harness base image (deploy/Containerfile at the
# pinned commit b041d5a6db0b1181d51d95190faf8f2c0808c38d) + this pilot's
# trusted verification stack:
#
#   /opt/git-pilot/bin/sandbox-git        vendored byte-exact wrapper (fixed path)
#   /opt/git-pilot/bin/verify.sh          verifier entrypoint
#   /opt/git-pilot/bin/verifier.py        deterministic final-state oracle
#   /opt/git-pilot/lib/git_pilot_fixture.py  vendored fixture helper (pure parts reused)
#   /opt/git-pilot/records/               TRUSTED provenance + pristine seed
#                                         (baked at build; outside the agent's
#                                         writable surface)
#
# The base image includes claude-code and codex but NOT OpenCode; the
# git-pilot README-operator (next unit) documents installing the pinned
# OpenCode CLI for the stock `--agent opencode` path. This unit does NOT
# build or run the image (offline packaging only).
#
# NOTE on the seed: harbor/image/records/seed-state.json is generated by
# harbor/git_pilot_package.py at package-generation time and copied here by
# the build step (see harbor/README-operator.md, next unit). The image build
# copies whatever records the generator produced, so the image and the task
# package are always provenance-matched.
#
# Build (this unit; requires network for base image + pinned artifacts):
#   podman build -f harbor/image/Containerfile \
#     -t localhost/git-pilot-harbor:1.0.0 \
#     --context <pilot root>
#
# Agent pin (see harbor/runtime-lock.json): the stock Harbor 0.25.0 OpenCode
# agent installs `opencode-ai@<version>` via npm at trial setup. The npm
# registry has NO 2.1.4: `opencode-ai` latest is 1.19.4 (the official stock
# package the Harbor agent source pins to), so 2.1.4 (the Homebrew/tap
# distribution this host inspected offline) is NOT the stock Harbor agent
# package version. The image therefore bakes the OFFICIAL stock npm package
# binary — opencode-linux-arm64 1.19.4, fetched from the official npm
# registry tarball, sha256-verified — so the in-image binary matches what
# `npm i -g opencode-ai@1.19.4` installs (postinstall copies the same bytes
# from the same optional-dependency package). Harbor's stock agent version
# probe (`opencode --version`) then reports 1.19.4, not 2.1.4.
#
# PERMISSIONS CONTRACT (task.toml: agent user "1001", verifier user "root"):
#   * /opt/git-pilot/**  — TRUSTED, root:root, dirs 0755, files 0644,
#     binaries 0755. NOT group-writable: the agent (UID 1001, GID 0) can
#     read/execute but never write the trusted verifier code or records.
#   * /workspace /logs /tests /solution /installed-agent — group 0 and
#     group-writable (g=u, 0775): fixtures are agent-writable and the root
#     verifier can write logs.
FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0

# Base image ships git + python3.12 already (verified: git 2.52.0, Python
# 3.12.15 on registry.access.redhat.com/ubi9/python-312@sha256:0de6d320...).
# No dnf step: keeps the build free of the Red Hat CDN subscription
# repositories (403 without entitlements) and of extra system packages.

# Python deps for the verifier: PyYAML is the only third-party import in the
# packaged input.yaml/answers.yaml parsing (the verifier itself is stdlib).
RUN pip install --no-cache-dir pyyaml==6.0.3
USER 0

# Pinned official stock OpenCode binary (linux/arm64) from the npm registry.
# Extracted on the host from the verified tarball into the build context so
# the build itself needs no npm postinstall and no network beyond the base
# image pull. Source: https://registry.npmjs.org/opencode-linux-arm64/-/opencode-linux-arm64-1.19.4.tgz
COPY harbor/image/bin/opencode-linux-arm64-1.19.4 /usr/local/bin/opencode

# Trusted verification stack at fixed paths.
COPY harbor/image/bin/sandbox-git /opt/git-pilot/bin/sandbox-git
COPY harbor/image/bin/verify.sh /opt/git-pilot/bin/verify.sh
COPY harbor/image/bin/verifier.py /opt/git-pilot/bin/verifier.py
COPY harbor/image/git_pilot_fixture.py /opt/git-pilot/lib/git_pilot_fixture.py

# TRUSTED records: provenance + pristine seed snapshot. The package
# generator writes these into the task package's tests/ dir; the build
# copies them from the generated package into the image so the image and
# package stay provenance-matched. The build context must therefore be the
# pilot root AFTER generate-package has run:
#   cases/<case-id>/tests/{provenance.json,seed-state.json}
# The fallback copy below keeps the image buildable even before the package
# is generated (the records dir may be empty in a fresh checkout).
COPY cases/return-main-no-cleanup-v1/tests/ /opt/git-pilot/records/

ENV PYTHONPATH=/opt/git-pilot/lib \
    HOME=/workspace \
    PATH=/opt/git-pilot/bin:/usr/local/bin:/usr/bin:/bin

# Agent-writable dirs: group 0, group-writable (fixture upload surface,
# Harbor log writes). /tests and /solution are pre-created because Harbor's
# verifier uploads there.
RUN mkdir -p /workspace /logs/verifier /logs/agent /logs/artifacts /tests /solution /installed-agent \
    && chgrp -R 0 /workspace /logs /tests /solution /installed-agent \
    && chmod -R g=u /workspace /logs /tests /solution /installed-agent \
    && chmod 755 /usr/local/bin/opencode

# TRUSTED verification stack: root:root, dirs 0755, files 0644, binaries 0755.
# Applied LAST and explicitly (no -R g=u on /opt/git-pilot) so the agent UID
# 1001 / GID 0 can read and execute but never write the verifier or records.
RUN chmod 755 /opt/git-pilot/bin /opt/git-pilot/lib /opt/git-pilot/records \
    && chmod 755 /opt/git-pilot/bin/sandbox-git /opt/git-pilot/bin/verify.sh \
    && chmod 644 /opt/git-pilot/bin/verifier.py \
    && chmod 644 /opt/git-pilot/lib/git_pilot_fixture.py \
    && chmod 644 /opt/git-pilot/records/* \
    && chown -R 0:0 /opt/git-pilot

WORKDIR /workspace
USER 1001
