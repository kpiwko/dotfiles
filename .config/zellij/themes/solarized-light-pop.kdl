themes {
    solarized-light-pop {
        // Normal UI text: dark readable text on the light terminal background
        text_unselected {
            base 88 110 117          // base01
            background 253 246 227   // base3
            emphasis_0 203 75 22     // orange
            emphasis_1 38 139 210    // blue
            emphasis_2 42 161 152    // cyan
            emphasis_3 133 153 0     // green
        }

        // Selected rows and search results
        text_selected {
            base 7 54 66             // base02
            background 238 232 213   // base2
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }

        // Focused tab / active mode
        ribbon_selected {
            // current mode: visible but not brighter than pane focus
            base 253 246 227
            background 88 110 117
            emphasis_0 253 246 227
            emphasis_1 238 232 213
            emphasis_2 42 161 152
            emphasis_3 203 75 22
        }

        ribbon_unselected {
            // available shortcuts: muted
            base 88 110 117
            background 238 232 213
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }       

        table_title {
            base 38 139 210          // blue, rather than green
            background 0
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }

        table_cell_selected {
            base 7 54 66
            background 238 232 213
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }

        table_cell_unselected {
            base 88 110 117
            background 253 246 227
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }

        list_selected {
            base 7 54 66
            background 238 232 213
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }

        list_unselected {
            base 88 110 117
            background 253 246 227
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }
        
        frame_unselected {
            // Very muted Solarized base1
            base 147 161 161
            background 0
            emphasis_0 147 161 161
            emphasis_1 147 161 161
            emphasis_2 147 161 161
            emphasis_3 147 161 161
        }

        frame_selected {
            // Orange has much stronger contrast than cyan here
            base 203 75 22
            background 0
            emphasis_0 203 75 22
            emphasis_1 203 75 22
            emphasis_2 203 75 22
            emphasis_3 203 75 22
        }
        
        // Orange indicates a non-base Zellij mode
        frame_highlight {
            base 203 75 22
            background 0
            emphasis_0 203 75 22
            emphasis_1 38 139 210
            emphasis_2 42 161 152
            emphasis_3 133 153 0
        }

        exit_code_success {
            base 133 153 0
            background 0
            emphasis_0 42 161 152
            emphasis_1 7 54 66
            emphasis_2 38 139 210
            emphasis_3 211 54 130
        }

        exit_code_error {
            base 220 50 47
            background 0
            emphasis_0 203 75 22
            emphasis_1 7 54 66
            emphasis_2 7 54 66
            emphasis_3 7 54 66
        }

        multiplayer_user_colors {
            player_1 211 54 130
            player_2 38 139 210
            player_3 133 153 0
            player_4 181 137 0
            player_5 42 161 152
            player_6 203 75 22
            player_7 220 50 47
            player_8 108 113 196
            player_9 88 110 117
            player_10 7 54 66
        }
    }
}
